## ASP.NET Core / .NET Stable Generic Gitignore ##
######################################################

# Combined build outputs and artifacts
[Dd]ebug/
[Dd]ebugPS/
[Rr]elease/
[Rr]eleasePS/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bsearch/
bin/
obj/

# Visual Studio cache, tracking, and runtime files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / IntelliJ WebStorm / JetBrains IDEs
.idea/
*.sln.iml

# Visual Studio Code workspace settings
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-snippets

# Local user secrets and environment‑specific settings
secrets.json
[App_Data]/
appsettings.Development.json
# Also ignore production config if it contains real secrets
# appsettings.Production.json   # uncomment if you keep secrets here

# Tooling, diagnostic logs, and crash dumps
*.log
*.log.*
*.dump
*.dmp
.diagnostic/

# Runtime logs folder (your Serilog file sink)
Logs/

# NuGet Package Manager folders (packages are restored by the compiler)
*.nuget.props
*.nuget.targets
pkgs/
packages/

# Build outputs and EF Core temporary files
*.exe
*.dll
*.pdb
*.efbundle

# OS-specific hidden file clutter
.DS_Store
Thumbs.db

# ─── Entity Framework Migrations ──────────────────────────
# Migrations are source code and should usually be tracked.
# Only uncomment the next line if you want to ignore them.
# Migrations/